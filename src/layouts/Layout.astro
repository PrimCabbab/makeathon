---
import '../styles/global.css';
const { title = 'Eudae', bodyClass = '' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/', 'Home'], ['/story', 'Digital story'], ['/videos', 'Videos'], ['/community', 'Community'], ['/subs', 'Prices']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · Eudae</title>
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600&f[]=gambarino@400&display=swap" />
</head>
<body class={bodyClass}>
  <header class="nav"><div class="wrap">
    <a class="logo" href="/">Eudae</a>
    <nav aria-label="Main"><ul>
      {links.map(([href, label]) => <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>)}
    </ul></nav>
  </div></header>
  <slot />
  <footer><div class="wrap">
    <span class="logo">Eudae</span>
    <p>Safer, kinder digital habits for teens and the people who support them.</p>
  </div></footer>
</body>
</html>
