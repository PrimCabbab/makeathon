---
import Layout from '../layouts/Layout.astro';
const plans = [
  { name: 'Free', price: '£0', items: ['Digital story', 'Weekly video pick', 'Community access'] },
  { name: 'Family', price: '£4/mo', items: ['Everything in Free', 'Full video library', 'Conversation starters for parents', 'Up to 5 profiles'], hl: true },
  { name: 'School', price: 'Licence', items: ['Everything in Family', 'Classroom lesson packs', 'Progress overview for teachers'] },
];
---
<Layout title="Subs">
  <section class="pagehead"><div class="wrap"><h1>Subs</h1><p>Pick the plan that fits your family or school. Prices are placeholders.</p></div></section>
  <section class="sec"><div class="wrap grid3">
    {plans.map(p => (
      <div class={`card ${p.hl ? 'hl' : ''}`}>
        <h3>{p.name}</h3><div class="price">{p.price}</div>
        <ul>{p.items.map(i => <li>{i}</li>)}</ul>
        <a class={`btn ${p.hl ? '' : 'alt'}`} href="#join">Choose {p.name}</a>
      </div>
    ))}
  </div></section>
  <section class="sec" id="join" style="padding-top:0"><div class="wrap" style="max-width:560px">
    <h2>Stay in the loop</h2>
    <form onsubmit="event.preventDefault();this.querySelector('output').textContent='Thanks! You are on the list.'">
      <label for="em">Email</label><input id="em" type="email" required />
      <p style="margin-top:1rem"><button class="btn">Subscribe</button></p><output role="status"></output>
    </form>
  </div></section>
</Layout>
